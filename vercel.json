{
    "version": 2,
    "builds": [
        {
            "src": "trip_logger/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.12"
            }
        },
        {
            "src": "trip_logger/static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "trip_logger/wsgi.py"
        }
    ]
}